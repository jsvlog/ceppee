# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (test keys start with sk_test_, live with sk_live_)
# ---- payment gateway -------------------------------------------------------
# HitPay wins when set: BSP-registered, accepts DTI + BIR 2303 sole props.
HITPAY_API_KEY=
HITPAY_SALT=
# HITPAY_API_BASE=https://api.sandbox.hit-pay.com   # while testing
# Xendit wins when both are set: PayMongo pauses new sign-ups.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# PAYMONGO_SECRET_KEY / PAYMONGO_WEBHOOK_SECRET work too, same routes.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Absolute site URL used for PayMongo return urls (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.teacherceppee.com

# Reconcile job: Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
